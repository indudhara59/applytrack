# MongoDB connection string (e.g. from MongoDB Atlas)
MONGODB_URI=

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET=

# Google OAuth credentials (Google Cloud Console -> APIs & Services -> Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Vercel Blob storage token (Vercel dashboard -> Storage -> Blob)
BLOB_READ_WRITE_TOKEN=
